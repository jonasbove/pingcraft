<?xml version="1.0" encoding="utf-8"?>
<!--
  PingCraft MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build pingcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc pingcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  Per-user install (no UAC prompt), by default into %LOCALAPPDATA%\Programs\PingCraft, with a Start menu
  shortcut carrying the AppUserModelID io.github.jonasbove.pingcraft (taskbar grouping, notifications later).
  The setup wizard is WiX's own (WixUI_InstallDir without the licence page: the code is MIT OR Apache-2.0, so
  there is nothing to accept). Its Finish page offers to start PingCraft. Uninstalling leaves the user's
  messages and sign-in (in %LOCALAPPDATA%\pingcraft and the Windows Credential Manager) alone.

  Per-user packages can't use a file as a component's KeyPath (ICE38), so each component is keyed on an HKCU
  value, and the folders it creates are removed on uninstall (ICE64).

  Structure adapted from CraftCloud's, itself from craft-launcher's (MIT OR Apache-2.0). The UpgradeCode and
  component GUIDs are PingCraft's own: never reuse them in another product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="PingCraft"
      Manufacturer="PingCraft"
      Version="$(var.Version)"
      UpgradeCode="EC6244FF-7849-4590-BF27-8DAD4663DEF3"
      Scope="perUser"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="PingCraft: all your chats in one inbox, on your own server" Manufacturer="PingCraft" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of PingCraft is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- The Apps & features and shortcut icon (keep the .exe extension, ICE50). -->
    <Icon Id="PingCraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PingCraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/jonasbove/pingcraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/jonasbove/pingcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/jonasbove/pingcraft/issues" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="PingCraft" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An update installs where the person put the previous version. -->
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\PingCraft" Name="InstallDir" Type="raw" />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="PingCraftRestoreFolder" Value="[PREVIOUSINSTALLFOLDER]"
        Before="CostInitialize" Sequence="both" Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />

    <Feature Id="Main" Title="PingCraft" Level="1">
      <ComponentGroupRef Id="PingCraftFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page: Welcome goes straight to the folder page. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPingCraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- The full version (Version is numeric, so it drops a pre-release tag), for pingcraft.en-us.wxl. -->
    <Property Id="PingCraftVersion" Value="$(var.DisplayVersion)" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="PingCraft $(var.DisplayVersion) is installed. Start it from the Start menu and sign in to your server." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start PingCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PingCraftExe]" />
    <!-- Runs in the wizard's own process, so PingCraft starts as the person, not elevated. -->
    <CustomAction Id="LaunchPingCraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="PingCraftFiles">
      <Component Id="PingCraftApp" Directory="INSTALLFOLDER" Guid="BC78C604-5D07-4AFB-97A5-FA8A1F0305D6">
        <File Id="PingCraftNotice" Source="$(var.BinDir)\NOTICE" KeyPath="no" />
        <File Id="PingCraftExe" Source="$(var.BinDir)\pingcraft.exe" KeyPath="no" />
        <!-- Read back by the next version's installer. -->
        <RegistryValue Root="HKCU" Key="Software\PingCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <!-- Win+R "pingcraft". -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\pingcraft.exe" Value="[#PingCraftExe]" Type="string" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveLocalProgramsFolder" Directory="LocalProgramsFolder" On="uninstall" />
      </Component>

      <Component Id="PingCraftShortcut" Directory="ProgramMenuFolder" Guid="CE5FAFFE-94E1-4391-A91C-2CCBED7AF55B">
        <Shortcut Id="StartMenuShortcut" Name="PingCraft"
            Description="All your chats in one inbox"
            Target="[#PingCraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="PingCraftIcon.exe">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="io.github.jonasbove.pingcraft" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\PingCraft" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
