# Copy to `.env` (git-ignored) and fill in. `.env` holds secrets: never commit it, never paste it anywhere.

# The server name ends every user ID (@you:example.com) and can NEVER change without starting over.
# Use a domain you own. Required.
PINGCRAFT_SERVER_NAME=

# The local name of the first (admin) user, who gets admin rights on the bridges.
PINGCRAFT_ADMIN_LOCALPART=admin

# Where the homeserver listens on the host. Loopback by default; use a TLS reverse proxy for anything else.
PINGCRAFT_BIND=127.0.0.1
PINGCRAFT_PORT=8008

# The host user that owns ./data (see `id -u` and `id -g`). The bridge drops to this user.
PINGCRAFT_UID=1000
PINGCRAFT_GID=1000

# Telegram: register an application at https://my.telegram.org (API development tools). Secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
