# PingCraft's reverse proxy, the one way into the stack (docs/deploy.md, ADR 0003 and its addendum).
#
# - Port 8008, plain HTTP, published on PINGCRAFT_BIND:PINGCRAFT_PORT: the homeserver, and each bridge's
#   provisioning API under /_pingcraft/bridges/<network>/, which PingCraft uses to connect networks. Put an
#   HTTPS reverse proxy in front of it for anything but this computer.
# - Ports 443 and 8448, HTTPS, inside the stack only: the server name, for the bridges' check of a user's OpenID
#   token. Federation stays off; only that one endpoint is forwarded.
{
	admin off
	# No certificates from the internet: the only HTTPS here is the stack's own certificate below.
	auto_https off
}

# One bridge's provisioning API, and nothing else of it: never its appservice API (/_matrix/app), debug endpoints
# or public media. Only requests that prove who the user is with an OpenID token pass; the bridge checks the token.
# The bridges would also take their admin's shared secret or a user's access token, which PingCraft never sends,
# so neither gets through from outside.
#   import bridge <network> <service:port>
(bridge) {
	handle_path /_pingcraft/bridges/{args[0]}/* {
		@provision {
			path /_matrix/provision/v3/*
			header Authorization "Bearer openid:*"
		}
		handle @provision {
			reverse_proxy {args[1]}
		}
		handle {
			respond 404
		}
	}
}

:8008 {
	import bridge telegram telegram:29317
	import bridge signal signal:29328
	import bridge whatsapp whatsapp:29318
	handle /_pingcraft/* {
		respond 404
	}
	handle {
		reverse_proxy homeserver:8008 {
			# The address that connected to this proxy, for the homeserver's per-address sign-in limits (its
			# `ip_source`). Set here, so a client cannot choose it.
			header_up X-Real-IP {remote_host}
		}
	}
}

# Only the bridges reach this: on the `openid` network the server name resolves to this proxy, and the bridges
# trust its certificate (setup.sh makes it). A bridge checks an OpenID token the federation way, over HTTPS at the
# server name, and refuses private addresses, so the homeserver's own address would not do.
https://{$PINGCRAFT_SERVER_NAME}:443, https://{$PINGCRAFT_SERVER_NAME}:8448 {
	tls /run/pingcraft-openid-tls/cert.pem /run/pingcraft-openid-tls/key.pem
	handle /_matrix/federation/v1/openid/userinfo {
		reverse_proxy homeserver:8008 {
			header_up X-Real-IP {remote_host}
		}
	}
	# Points the bridge at port 8448 here, so it never follows a public SRV record for the server name.
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server": "{$PINGCRAFT_SERVER_NAME}:8448"}`
	}
	respond 404
}
